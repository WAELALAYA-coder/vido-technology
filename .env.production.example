# Copy this file to .env.production on the production host.
# Replace every placeholder using a password manager or secret generator.
# Do not commit the real .env.production file.

VIDO_DOMAIN=learn.example.com

# Use URL-safe random text only (A-Z, a-z, 0-9, _ and -), e.g.
# node -p "require('node:crypto').randomBytes(48).toString('base64url')"
POSTGRES_PASSWORD=REPLACE_WITH_64_CHAR_BASE64URL_SECRET

# Must be a unique random secret with at least 32 characters.
JWT_SECRET=REPLACE_WITH_UNIQUE_RANDOM_JWT_SECRET

OWNER_EMAIL=owner@example.com
OWNER_PASSWORD=REPLACE_WITH_UNIQUE_PASSWORD_AT_LEAST_12_CHARS

ADMIN_USERNAME=Admin
ADMIN_PASSWORD=REPLACE_WITH_DIFFERENT_UNIQUE_PASSWORD_AT_LEAST_12_CHARS

# Keep account self-registration closed for the initial private launch.
REGISTRATION_ENABLED=false

# Must match the fixed Caddy container IP in compose.production.yml.
TRUSTED_PROXY_IP=172.29.250.2

# Optional AI tutor configuration. Leave empty to keep the AI tutor disabled.
AI_API_URL=
AI_API_KEY=
AI_MODEL=
