# Copy this file to .env before starting Docker Compose.
# Use strong, unique values in production.
JWT_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_BYTES
OWNER_EMAIL=owner@example.invalid
OWNER_PASSWORD=REPLACE_WITH_STRONG_UNIQUE_OWNER_PASSWORD

# Optional VIDO Tutor integration
AI_API_URL=
AI_API_KEY=
AI_MODEL=

# Quick admin login (server-side only; never hardcode a public password)
ADMIN_USERNAME=Admin
ADMIN_PASSWORD=REPLACE_WITH_STRONG_UNIQUE_ADMIN_PASSWORD
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_UNIQUE_DATABASE_PASSWORD
